  "researchLines": [
    "ROK written armistice non-obstruction commitment and its qualifications",
    "ROK draft mutual defense treaty territorial scope",
    "automatic response versus constitutional-process treaty language",
    "UNC operational control after armistice",
    "NNRC/Indian custodial-force location and security",
    "Communist demand for ROK compliance guarantees",
    "POW escapee recapture dispute",
    "political-conference 90-day understanding",
    "ROK request for post-conference military support",
    "neutralization as U.S. internal bargaining concept",
    "Korean reconstruction aid governance",
    "Combined Economic Board coordination",
    "UNKRA/ECA overhead and procurement criticism",
    "Tasca reconstruction program",
    "$200m initial reconstruction tranche",
    "ROK military conversion rate",
    "ROK local-cost burden for UN forces",
    "20-division ROK force program",
    "additional UN forces/reimbursement policy",
    "Dulles August political-conference consultations",
    "ROK-US treaty negotiation",
    "ROK military-service chiefs in aid/force talks",
    "armistice signature and ROK non-signature",
    "civilian food relief and KCAC implementation"
  ],
  "keyFindings": [
    {
      "docs": [
        "FRUS-XV2-d681",
        "FRUS-XV2-d683"
      ],
      "finding": "Rhee's July 9 letter formally accepted non-obstruction of the armistice but retained a national-survival qualification; Robertson treated it as a major retreat from earlier demands, not an unconditional blank check."
    },
    {
      "docs": [
        "FRUS-XV2-d682"
      ],
      "finding": "The Korean draft treaty claimed lawful ROK jurisdiction to the Yalu/Tumen and proposed immediate mutual assistance language, demonstrating that the Korean draft was broader than the eventual constitutional-process formulation."
    },
    {
      "docs": [
        "FRUS-XV2-d685",
        "FRUS-XV2-d687",
        "FRUS-XV2-d696",
        "FRUS-XV2-d698"
      ],
      "finding": "UNC could assure compliance of forces under its command but separately debated how far it could guarantee ROK governmental compliance and whether logistics could be cut off; force against ROK forces was explicitly not promised."
    },
    {
      "docs": [
        "FRUS-XV2-d699"
      ],
      "finding": "NSC 156/1 linked reconstruction and military expansion to post-armistice policy and recorded that implementation had been deferred while the Korean situation remained unclear."
    },
    {
      "docs": [
        "FRUS-XV2-d722",
        "FRUS-XV2-d723"
      ],
      "finding": "On July 27 Rhee said he would cooperate with the armistice; the ROK did not sign the armistice, while UNC and Communist commanders did."
    },
    {
      "docs": [
        "FRUS-XV2-d728",
        "FRUS-XV2-d737",
        "FRUS-XV2-d738",
        "FRUS-XV2-d739"
      ],
      "finding": "Post-armistice reconstruction became a governance dispute over CEB coordination, UN/US agency overlap, appropriations, exchange/conversion rates, local-cost burdens, and military-economic sequencing."
    },
    {
      "docs": [
        "FRUS-XV2-d734",
        "FRUS-XV2-d739"
      ],
      "finding": "Paik Tu-chin, Pyun Yong-tae and Sohn Won-il participated as substantive Korean cabinet actors in August talks; Paik separately pressed economic-aid implementation and burden-sharing questions."
    }
  ],
  "countingNote": "60 distinct FRUS document pages d680-d739 were directly opened in this run. They are official published diplomatic records; individual documents may contain memoranda, telegrams, policy papers, editorial notes, or reproduced primary records. Count is document-page count, not unique archival folder count."
