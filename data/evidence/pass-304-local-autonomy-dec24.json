  "claims": [
    {
      "id": "claim-local-autonomy-1958-law501-01",
      "statement": "1958-12-24 처리된 지방자치법 개정은 1958-12-26 법률 제501호로 공포·시행되었다.",
      "status": "SUPPORTED_CROSS_PROVENANCE",
      "evidence": ["doc-pa-rhee-local-autonomy-index", "doc-aks-local-autonomy", "doc-law501-text-mirror"]
    },
    {
      "id": "claim-local-autonomy-1958-appointment-01",
      "statement": "법률 제501호 제98조 체계에서 도지사와 서울특별시장은 대통령이 임명하고, 시장은 도지사 추천·내무부장관 경유로 대통령이, 읍·면장은 군수 추천으로 도지사가 임명하는 구조가 확인된다.",
      "status": "SUPPORTED_TEXT_RECOVERED_NONOFFICIAL_MIRROR",
      "evidence": ["doc-law501-text-mirror", "doc-khdb-constitutional-local-autonomy"],
      "limits": "조문 텍스트는 공개 법령 미러와 국사편찬위원회 해제를 교차확인했다. 국가법령정보센터/관보 원문 이미지 직접 회수는 다음 표적이다."
    },
    {
      "id": "claim-local-autonomy-1958-scope-01",
      "statement": "제4차 개정은 단체장 임명제 외에도 법정회의일수 초과시 폐회명령, 폐회중 위원회 제도 폐지, 지방의원 임기 연장, 이·동장 임명제, 의장단 불신임제 폐지 등을 포함했다.",
      "status": "SUPPORTED_INSTITUTIONAL_REFERENCE",
      "evidence": ["doc-aks-local-autonomy"]
    },
    {
      "id": "claim-local-autonomy-1960-reversal-01",
      "statement": "4·19 이후 제3차 헌법개정과 1960년 지방자치법 개정은 1958년의 임명제 방향을 되돌려 지방자치단체장 선출 구조를 복원하는 방향으로 진행됐다.",
      "status": "SUPPORTED_CROSS_PROVENANCE",
      "evidence": ["doc-khdb-constitutional-local-autonomy", "doc-law563-history"]
    },
    {
      "id": "claim-local-autonomy-rhee-causation-boundary-01",
      "statement": "법률 제501호가 이승만 재임기에 공포되고 대통령 임명권을 확대했다는 사실만으로 12월24일 현장 강행처리의 구체적 사전 지휘를 이승만에게 귀속할 수는 없다.",
      "status": "NARROWED_CONFLICT_SENSITIVE",
      "evidence": ["doc-frus-1958-260", "doc-frus-1958-262", "doc-pa-rhee-local-autonomy-index"],
      "open": "경무대-내무부-자유당-민의원 사이의 법안 기획·경위권/경찰동원 결재·보고 원문"
    }
